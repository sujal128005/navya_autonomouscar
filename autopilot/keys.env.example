# Copy this file to keys.env (same folder) and paste your free keys after the = sign.
# keys.env is git-ignored, so your keys never go to GitHub. Never share them in chat.
#
# Gemini (free, no card): https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Groq (free, no card): https://console.groq.com -> "API Keys"
GROQ_API_KEY=
